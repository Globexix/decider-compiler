// @state tick: 0..7 = 0
// @state x: 4..4 = 4
// @state y: 0..15 = 8
// @state rise: 0..3 = 0
// @state rng: 0..6 = 0
// @state phase: 0..6 = 2
// @state hit: 0..1 = 0
// @state score_ones: 0..9 = 0
// @state score_tens: 0..9 = 0

// @array pipes: Pipe[4]
// @field pipes.offset: 0..21 = 0,7,14,21
// @field pipes.gap_y: 2..8 = 4,4,4,2
// @field pipes.enabled: 0..1 = 0,0,0,1

// @input flap = signal-F
// @state held: 0..1 = 0

// @screen 24x16
// @point x,y icon=logistic-robot

// @number score_tens at=0,15
// @number score_ones at=1,15

// @rect upper x=(phase+pipes.offset) y=0 width=2 height=pipes.gap_y enabled=pipes.enabled icon=signal-green
// @rect lower x=(phase+pipes.offset) y=(pipes.gap_y+5) width=2 height=(16-pipes.gap_y-5) enabled=pipes.enabled icon=signal-green

struct Pipe { offset i32, gap_y i32, enabled bool }

fn update_tick(tick i32, hit bool) i32 {
    if hit { return 0 }
	if tick == 7 { return 0 }
	return tick + 1
}

fn update_phase(phase i32, tick i32, hit bool) i32 {
    if hit { return 2 }
    if tick != 7 { return phase }
    if phase == 0 { return 6 }
    return phase - 1
}

fn update_rng(rng i32, pipes addr, tick i32, phase i32) i32 {
    if tick != 7 || phase != 0 { return rng }
    if rng >= 4 { return rng - 4 }
    return rng + 3
}

fn update_pipes(pipes addr, tick i32, rng i32, phase i32, hit bool) void {
    view items = pipes[arr[4, Pipe]]

    if hit {
        for const i usize in 0..4 {
            items[i].gap_y = 4
            items[i].enabled = false
        }

        items[3].gap_y = 2
        items[3].enabled = true
        return
    }

    if tick != 7 || phase != 0 { return }
    
    for const i usize in 0..3 {
        items[i].gap_y = items[i+1].gap_y
        items[i].enabled = items[i+1].enabled
    }

    items[3].gap_y = rng + 2
    items[3].enabled = true
}

fn hits_pipe(pipes addr, phase i32, x i32, y i32) bool {
    view items = pipes[arr[4, Pipe]]

    for const i usize in 0..4 {
        if items[i].enabled {
            pipe_x i32 = phase + items[i].offset

            if x >= pipe_x && x < pipe_x + 2 {
                if y < items[i].gap_y || y >= items[i].gap_y + 5 {
                    return true
                }
            }
        }
    }

    return false
}

fn passed_pipe(tick i32, phase i32, pipes addr) bool {
    view items = pipes[arr[4, Pipe]]
    return tick == 7 && phase == 2 && items[0].enabled
}

fn update_score_ones(score_ones i32, tick i32, phase i32, pipes addr, hit bool) i32 {
    if hit { return 0 }

    if !passed_pipe(tick, phase, pipes) { return score_ones }
    if score_ones == 9 { return 0 }
    
    return score_ones + 1
}

fn update_score_tens(score_tens i32, score_ones i32, tick i32, phase i32, pipes addr, hit bool) i32 {
    if hit { return 0 }

    if !passed_pipe(tick, phase, pipes) { return score_tens }
    if score_ones != 9 { return score_tens }
    if score_tens == 9 { return 0 }

    return score_tens + 1
}

fn update_hit(pipes addr, phase i32, x i32, y i32, hit bool) bool {
    if hit { return false }
    return hits_pipe(pipes, phase, x, y)
}

fn update_x(x i32) i32 {
	return x
}

fn update_held(flap bool) bool {
    return flap
}

fn update_rise(rise i32, tick i32, flap bool, held bool, hit bool) i32 {
    if hit { return 0 }
    if flap && !held { return 3 }

    if tick == 7 && rise > 0 { return rise - 1 }
    return rise
}

fn update_y(y i32, tick i32, rise i32, hit bool) i32 {
    if hit { return 8 }
    if tick != 7 { return y }

    if rise > 0 {
        if y > 0 { return y - 1 }
        return y
    }

    if y < 15 { return y + 1 }
    return y
}